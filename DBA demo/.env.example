# =============================================================================
# SQL Server to PostgreSQL Migration — Environment Variables
# =============================================================================
# Copy this file to .env and adjust:
#   cp .env.example .env
#
# This file supports TWO modes:
#
#   1) DEMO mode (default values below) — local Docker WideWorldImporters lab.
#      Just `cp .env.example .env` and run `bash scripts/setup-local-env.sh`.
#
#   2) BRING-YOUR-OWN-ENDPOINT mode — point at any customer SQL Server and
#      any PostgreSQL (Azure Flexible Server, AWS RDS, on-prem, etc.).
#      Edit the SQLSERVER_* and PG_* variables below, then run
#      `bash scripts/migrate-endpoint.sh`.
#
# Values are single-quoted so bash `source` and docker-compose both parse
# them correctly (semicolons and spaces would otherwise break bash).
# =============================================================================

# ---------------------------------------------------------------------------
# SQL Server (source)
# ---------------------------------------------------------------------------
SA_PASSWORD='Str0ngP@ssw0rd!'                     # Used by docker-compose for the local demo

SQLSERVER_HOST='localhost'                        # e.g. 'mycorp-sql.database.windows.net'
SQLSERVER_PORT='1433'
SQLSERVER_DB='WideWorldImporters'                 # Your customer DB name
SQLSERVER_USER='sa'                               # e.g. 'migrate_user'
SQLSERVER_PASSWORD='Str0ngP@ssw0rd!'              # Mirror of SA_PASSWORD for the demo

# ---------------------------------------------------------------------------
# PostgreSQL (target)
# ---------------------------------------------------------------------------
PG_PASSWORD='Str0ngP@ssw0rd!'                     # Used by docker-compose for the local demo

PG_HOST='localhost'                               # e.g. 'mycorp-pg.postgres.database.azure.com'
PG_PORT='5432'
PG_USER='wwi_user'                                # e.g. 'migrate_user'
PG_DB='wide_world_importers'                      # Your target DB name

# ---------------------------------------------------------------------------
# DAB (Data API Builder) connection strings — read by dab/dab-config-*.json
# ---------------------------------------------------------------------------
SQLSERVER_CONN='Server=localhost,1433;Database=WideWorldImporters;User Id=sa;Password=Str0ngP@ssw0rd!;TrustServerCertificate=True;'
POSTGRES_CONN='Host=localhost;Port=5432;Database=wide_world_importers;Username=wwi_user;Password=Str0ngP@ssw0rd!;'

# ---------------------------------------------------------------------------
# Optional: Microsoft Fabric SQL DB (Phases 4-5)
# ---------------------------------------------------------------------------
# FABRIC_CONN='Server=your-server.database.fabric.microsoft.com;Database=WideWorldImporters;Authentication=Active Directory Default;'
