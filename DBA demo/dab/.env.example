# DAB connection strings
# ---------------------------------------------------------------
# Primary config is in the root .env.example — copy it to .env:
#   cp ../.env.example ../.env
#
# The SQLSERVER_CONN and POSTGRES_CONN variables below are
# referenced by dab-config-*.json via @env('SQLSERVER_CONN') etc.
# They are already defined in the root .env.example.
# ---------------------------------------------------------------

# SQL Server (source - Docker container on localhost:1433)
SQLSERVER_CONN=Server=localhost,1433;Database=WideWorldImporters;User Id=sa;Password=Str0ngP@ssw0rd!;TrustServerCertificate=True;

# PostgreSQL (target - Docker container on localhost:5432)
POSTGRES_CONN=Host=localhost;Port=5432;Database=wide_world_importers;Username=wwi_user;Password=Str0ngP@ssw0rd!;

# Fabric SQL DB (optional — Phase 4/5)
# FABRIC_CONN=Server=your-server.database.fabric.microsoft.com;Database=WideWorldImporters;Authentication=Active Directory Default;
